# syntax=docker/dockerfile:1
FROM alpine:3.20

# ✅ GÜVENLİ BUILDKIT YÖNTEMİ: --mount=type=secret
# Parola diske veya imaj katmanına ASLA YAZILMAZ! Sadece bu komut anında bellekte var olur.
RUN --mount=type=secret,id=api_token \
    TOKEN=$(cat /run/secrets/api_token) && \
    echo "Ozel depodan guvenle paket indirildi (Token kullanildi ve bellekten uctu)." > /app.log

CMD ["cat", "/app.log"]
