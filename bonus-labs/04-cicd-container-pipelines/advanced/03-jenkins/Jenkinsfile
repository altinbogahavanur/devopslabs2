pipeline {
    agent any

    environment {
        REGISTRY_URL = 'registry.gitlab.com/devopsatolyesi/docker-labs'
        IMAGE_NAME   = 'microservice-app'
        IMAGE_TAG    = "${env.BUILD_NUMBER}"
        // Jenkins Credentials ID: 'docker-hub-credentials'
        DOCKER_CREDS = credentials('docker-registry-credentials')
    }

    stages {
        stage('1. Checkout') {
            steps {
                echo 'Kaynak kodlar repodan cekiliyor...'
                checkout scm
            }
        }

        stage('2. Lint Dockerfile') {
            steps {
                echo 'Dockerfile statik analizi yapiliyor (Hadolint)...'
                sh 'docker run --rm -v $(pwd):/work -w /work hadolint/hadolint:latest hadolint Dockerfile || true'
            }
        }

        stage('3. Docker Build') {
            steps {
                echo "Docker imajı derleniyor: ${IMAGE_NAME}:${IMAGE_TAG}..."
                sh "docker build -t ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG} -t ${REGISTRY_URL}/${IMAGE_NAME}:latest ."
            }
        }

        stage('4. Security Scan (Trivy)') {
            steps {
                echo 'Trivy ile CVE taramasi yurutuluyor...'
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy:latest image --severity HIGH,CRITICAL --exit-code 0 ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }

        stage('5. Push to Registry') {
            steps {
                echo 'Imza ve etiketler Registry/Harbor uzerine gonderiliyor...'
                sh """
                    echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin ${REGISTRY_URL}
                    docker push ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${REGISTRY_URL}/${IMAGE_NAME}:latest
                """
            }
        }
    }

    post {
        always {
            echo 'Yerel temizlik yapiliyor...'
            sh "docker rmi -f ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG} || true"
        }
        success {
            echo '✅ Pipeline basariyla tamamlandi!'
        }
        failure {
            echo '❌ Pipeline basarisiz oldu. Lutfen loglari inceleyin.'
        }
    }
}
