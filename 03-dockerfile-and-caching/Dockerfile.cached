# ==============================================================================
# ✅ EN İYİ UYGULAMA (BEST PRACTICE - DOĞRU KATMAN SIRALAMASI):
# 1. Yalnızca paket tanım dosyaları (package*.json) kopyalanır.
# 2. 'npm install' çalıştırılır.
# 3. Bağımlılıklar değişmediği sürece bu katmanlar Docker önbelleğinden (CACHED) gelir!
# 4. En son kaynak kodlar kopyalanır. Kod değişse bile derleme 0.2 saniyede biter.
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Sadece bağımlılık tanımlayıcılarını kopyala (Cache-Friendly)
COPY app/package*.json ./

# Bağımlılıkları yükle (package.json değişmediği sürece CACHE kullanılır)
RUN npm install

# Şimdi değişen uygulama kaynak kodlarını kopyala
COPY app/ ./

EXPOSE 3000

CMD ["node", "server.js"]
