FROM python:3.12-alpine

# 1. Non-root kullanıcı ve grup tanımla (UID 10001)
RUN addgroup -g 10001 -S appgroup && \
    adduser -u 10001 -S appuser -G appgroup

WORKDIR /app
COPY --chown=appuser:appgroup app.py .

# 2. Root kullanıcısını terk et
USER 10001:10001

EXPOSE 8080

CMD ["python", "app.py"]
