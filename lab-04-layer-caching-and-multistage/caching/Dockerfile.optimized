# ==============================================================================
# ✅ DOĞRU PRATİK (Hızlı Derleme - Katman Önbellekleme):
# 1. Önce yalnızca paket tanımı (package*.json) kopyalanır.
# 2. 'npm install' çalıştırılır.
# 3. Paket tanımları değişmediği sürece bu katman Docker önbelleğinden (CACHED) gelir!
# 4. En son kaynak kod kopyalanır. Kod değiştiğinde derleme 0.2 saniyede tamamlanır!
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# 1. Sadece bağımlılık tanımlayıcılarını kopyala (Cache-Friendly)
COPY package*.json ./

# 2. Bağımlılıkları yükle (package.json değişmediği sürece CACHE kullanılır)
RUN npm install

# 3. Şimdi değişen uygulama kaynak kodlarını kopyala
COPY . .

EXPOSE 3000

CMD ["node", "server.js"]
