# ==============================================================================
# ⚠️ KÖTÜ PRATİK (Yavaş Derleme):
# Tüm dosyalar (COPY . .) kopyalandıktan sonra 'npm install' çalıştırılıyor.
# Kaynak kodda tek bir satır değiştiğinde önbellek (cache) patlar (cache bust)
# ve Docker her build işleminde sıfırdan 'npm install' çalıştırmak zorunda kalır!
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# HATA: Kodlar ve paket tanımları aynı anda kopyalanıyor
COPY . .

# Bu satır her kod değişikliğinde tekrar tekrar internetten paket indirir (YAVAŞ)
RUN npm install

EXPOSE 3000

CMD ["node", "server.js"]
