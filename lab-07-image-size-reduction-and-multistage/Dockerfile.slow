# ==============================================================================
# ⚠️ ANTİ-PATTERN (KÖTÜ KATMAN SIRALAMASI):
# Önce tüm dosyalar (COPY . .) kopyalanıyor, ardından 'npm install' çalıştırılıyor.
# Kaynak kodda tek bir karakter değiştiğinde bile 'COPY' katmanı önbelleği (cache)
# patlatır ve Docker her build işleminde sıfırdan 'npm install' çalıştırmak zorunda kalır!
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# HATA: Kodlar ve bağımlılık tanımları aynı anda kopyalanıyor
COPY . .

# Bu satır her kod değişikliğinde tekrar tekrar internetten paket çeker (YAVAŞ)
RUN npm install

EXPOSE 3000

CMD ["node", "app/server.js"]
